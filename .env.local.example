# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Meta Ads
META_APP_ID=
META_APP_SECRET=

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# GA4
# Same value as GOOGLE_ADS_CLIENT_ID/SECRET => one Google reconnect fixes Ads + GA4.
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
# Optional: service account JSON key (raw JSON or base64) for GA4 that never
# expires. Add its client_email as Viewer in each GA4 property.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Crypto (do szyfrowania tokenów w DB)
ENCRYPTION_KEY=

# Cron auth
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev only: per-request query log in the server console (lib/supabase/perf.ts).
# 1 = one summary line per request (queries, rows, time, cache hits),
# 2 = also every query. Leave unset in production.
# PERF_LOG=1

# Who may log in. Agency mailboxes by domain (default patoagencja.com; never
# "*" in production - that lets every account in).
# LOGIN_ALLOWED_DOMAINS=patoagencja.com
# Invited client users ("Dostęp do panelu") may log in only when this is 1.
# Off by default: until then nobody outside the agency domains gets in.
# CLIENT_LOGIN_ENABLED=1
